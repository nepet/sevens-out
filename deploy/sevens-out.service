# Option 5 without Docker: systemd keeps the Node server running.
#   sudo cp deploy/sevens-out.service /etc/systemd/system/ && sudo systemctl enable --now sevens-out
# Put Caddy (or nginx) in front for HTTPS:  reverse_proxy localhost:8788
[Unit]
Description=Sevens Out room server
After=network-online.target

[Service]
User=sevens
WorkingDirectory=/opt/sevens-out
Environment=PORT=8788 HOST=127.0.0.1 DATA_DIR=/var/lib/sevens-out
ExecStart=/usr/bin/node server/node/server.js
Restart=always
StateDirectory=sevens-out
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
